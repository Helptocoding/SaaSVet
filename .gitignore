.claude/

# Credenciales — NUNCA subir
backend/.env
*.env
# .env.prod / .env.prod.local / etc. NO match con `*.env` (ese glob solo cubre
# nombres TERMINADOS en .env). Capa 2 introduce .env.prod en raíz — bloqueado
# aquí. Plantilla `*.example` se sigue versionando.
.env.prod
.env.prod.*
!.env.prod.example
!.env.example

# Logs
backend/logs/*.log

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node
node_modules/
dist/
# Stray vite build output (`--outDir dist-test`); not covered by `dist/`.
frontend/dist-test/
# Build-script approval lives in frontend/package.json (pnpm.onlyBuiltDependencies).
# pnpm 10/11 auto-regenerates a frontend/pnpm-workspace.yaml stub on install; that
# stub has no `packages:` and breaks pnpm 9 in CI ("packages field missing or empty").
# Ignore it so the regenerated file is never committed.
frontend/pnpm-workspace.yaml

# Local junk / QA / design assets
nul
reports/
gemini/
frontend/img/

# E2E test file with hardcoded creds
backend/test_e2e.py

.env
.env.*
credentials.json
*.pem
*.key
.credentials

# Deploy state (P1-6B) — local pointer file written by scripts/deploy.sh on the
# VPS (current/previous image tag + pre-deploy snapshot path). Host-specific,
# never versioned.
.deploy-state

# Artefactos locales / experimentos (no proyecto)
CON
_pdf_preview/
references/
svgcomponentes/
frontend/standalone/
.kiro/
.agents/
.codebase-memory/

# Estado local de agtx. La configuración de proyecto sí se comparte.
.agtx/*
!.agtx/config.toml
