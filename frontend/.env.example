VITE_API_URL=http://127.0.0.1:8000/api/

# Sentry — dejar vacío en dev, poner DSN de producción
# Obtener en: https://sentry.io → tu proyecto → Settings → Client Keys → DSN
VITE_SENTRY_DSN=

# P1-5: tags de Sentry browser. environment separa prod/staging/dev; release
# agrupa issues por deploy y resuelve los source maps subidos con ese release.
# Default: VITE_SENTRY_ENVIRONMENT cae al modo de Vite; release = SHA del build.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Discord webhook para el botón de soporte (FeedbackButton).
# Sin esto, "Enviar a Soporte" falla.
# ADVERTENCIA: las vars VITE_ se incrustan en el bundle del cliente → esta URL
# queda pública y es spameable. A futuro conviene proxiarla por el backend.
VITE_DISCORD_WEBHOOK_URL=
