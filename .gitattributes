# Force LF line endings for files that run inside Linux containers.
# Windows checkouts default to CRLF, which breaks shell scripts (shebang +
# `\r` makes the kernel look for `/bin/sh\r`). This file makes git store
# AND check out these paths with LF regardless of host OS.

*.sh           text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
Caddyfile      text eol=lf
*.conf         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# B9E evidence hashes cover exact bytes, including Windows subprocess CRCRLF.
# Preserve receipts on checkout; raw logs are not code whitespace diffs.
.gitattributes text eol=lf
backend/apps/agent/tests/b9e*.py text eol=lf
backend/apps/agent/tests/test_b9e*.py text eol=lf
docs/evals/b9e-* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evals/b9e-*.log -diff
docs/evals/profile-beta-1-* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reporte-aceptacion-b9-profile-beta-1-2026-09-29.md text eol=lf

# E4 test evidence preserves bytes independently of the historical B9E receipts.
backend/apps/agent/tests/e4*.py text eol=lf
docs/evals/e4-* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evals/e4-*.log -diff
docs/evals/e4-claim/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evals/e4-claim/*.log -diff
backend/apps/agent/tests/test_e4*.py text eol=lf
docs/diagnostico-e4-eligible-claim-2026-09-30.md text eol=lf
docs/diagnostico-e4-capacidad-scheduling-2026-09-30.md text eol=lf

# W1 monotonic test evidence follows the same byte-preservation convention.
backend/apps/agent/tests/w1_mono*.py text eol=lf
backend/apps/agent/tests/test_w1_mono*.py text eol=lf
docs/evals/w1-mono/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evals/w1-mono/*.log -diff
