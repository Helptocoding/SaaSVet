DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-segura-en-produccion
ALLOWED_HOSTS=tu-dominio.railway.app

PGDATABASE=veterinaria_saas
PGUSER=postgres
PGPASSWORD=TU_PASSWORD_AQUI
PGHOST=localhost
PGPORT=5432

# Sentry — dejar vacío en dev, poner DSN de producción
# Obtener en: https://sentry.io → tu proyecto → Settings → Client Keys → DSN
SENTRY_DSN=

# P1-5: versión desplegada. /api/version/ la expone y Sentry la usa como release.
# El deploy las setea con el SHA del commit (ej. GIT_SHA=$(git rev-parse --short HEAD)).
GIT_SHA=
APP_VERSION=

# Security headers — activar en producción (dejar en False en dev)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Discord webhook para el boton de soporte (FeedbackButton → backend proxy).
# Sin esto, el endpoint /api/support/message/ responde 503.
# Dejar vacio en dev (el boton de soporte no enviara nada).
# Ejemplo: https://discord.com/api/webhooks/123456789/abc-def_ghi
DISCORD_WEBHOOK_URL=

# Inbox media: capture metadata always; processing requires explicit enablement.
# Development/CI only. Keep private files outside static/public directories.
INBOX_MEDIA_ENABLED=False
MEDIA_BACKEND=local
INBOX_MEDIA_ALLOW_LOCAL=False
INBOX_MEDIA_ROOT=private-media
# Optional absolute path, basename MUST be saaslyvet-inbox-media-spool.
INBOX_MEDIA_SPOOL_ROOT=
INBOX_MEDIA_ACCESS_HOLD=False
INBOX_MEDIA_REVOCATION_ROOT=
INBOX_MEDIA_OPS_OWNER=
# Production: dedicated private B2 bucket/key; never reuse backup credentials.
# Enable only after the p60 privacy/storage/retention gates are recorded.
INBOX_MEDIA_PRODUCTION_APPROVED=False
MEDIA_B2_ENDPOINT_URL=
MEDIA_B2_REGION_NAME=
MEDIA_B2_BUCKET=
MEDIA_B2_ACCESS_KEY_ID=
MEDIA_B2_SECRET_ACCESS_KEY=
