+                method = next(node for node in cls.body if isinstance(node, ast.FunctionDef) and
+                              node.name == 'test_fields_match_snapshot')
+                calls = [node for node in ast.walk(method) if isinstance(node, ast.Call) and
+                         isinstance(node.func, ast.Attribute) and node.func.attr == 'assertEqual']
+                _require(len(calls) == 1 and len(calls[0].args) == 2 and
+                         isinstance(calls[0].args[1], ast.List), 'snapshot equality assertion changed')
+                calls[0].args[1] = ast.List(elts=[], ctx=ast.Load())
+                found.add(cls.name)
+        _require(found == classes, 'snapshot test classes changed')
+    _require(ast.dump(old_ast, include_attributes=False) == ast.dump(new_ast, include_attributes=False),
