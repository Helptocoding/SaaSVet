--- native-r9/prepare_references.py
+++ native/prepare_references.py
@@ -0,0 +1,77 @@
+"""Snapshot completed r9 evidence and retain prior campaigns without alterations."""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+HERE = Path(__file__).resolve().parent
+PRIOR = HERE.with_name('b9-correction-20261020-native-r9')
+REPO = HERE.parents[2]
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def read(path):
+    return json.loads(path.read_text(encoding='utf-8'))
+
+
+def save(name, data):
+    p = HERE / name
+    assert not p.exists(), p
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\n', encoding='utf-8', newline='\n')
+
+
+def main():
+    retirement = read(HERE / 'previous-cluster-retirement.json')
+    assert retirement['state'] == 'PASS' and retirement['previous_campaign'] == PRIOR.name
+    assert retirement['old_final_logs_closed_before_prior_evidence_snapshot'] is True
+    oldlog = retirement['previous_log']
+    assert sha(Path(oldlog['path'])) == oldlog['sha256']
+    target = HERE / 'referenced-completed-evidence/r9'
+    assert not target.exists()
+    paths = sorted(p for p in PRIOR.rglob('*') if p.is_file() and '__pycache__' not in p.parts)
+    inventory = {}
+    for source in paths:
+        relative = source.relative_to(PRIOR).as_posix()
+        assert not source.is_symlink() and not source.is_junction()
+        destination = target / relative
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(source, destination)
+        wanted = sha(source)
+        assert sha(destination) == wanted
+        inventory[relative] = {'sha256': wanted, 'bytes': source.stat().st_size}
+    candidate = read(HERE / 'candidate.json')
+    save('completed-reference-manifest.json', {'schema': 'b9-completed-r9-reference/1',
+        'source_campaign': PRIOR.name, 'source_candidate_tree': candidate['previous_candidate_tree'],
+        'candidate_tree': candidate['candidate_tree'], 'bundle_relative': 'referenced-completed-evidence/r9',
+        'original_relative': '../' + PRIOR.name, 'files': inventory,
+        'original_backend_executions_claimed_as_current': False,
+        'original_frontend_timeout_and_exit_1_preserved': True})
+    prior = {}
+    for folder in HERE.parent.iterdir():
+        if folder.is_dir() and folder != HERE and (folder.name.startswith('b9-correction-') or
+            folder.name.startswith('b9-integral-acceptance-1947726')):
+            prior.update({p.relative_to(REPO).as_posix(): sha(p) for p in folder.rglob('*')
+                if p.is_file() and '__pycache__' not in p.parts})
+    save('prior-evidence-before.json', prior)
+    policy_path = HERE / 'resource-policy.json'
+    policy = read(policy_path)
+    for key, value in list(policy.items()):
+        if key.endswith('authorization') and isinstance(value, str) and not (HERE / value).exists():
+            assert (target / value).is_file()
+            policy[key] = 'referenced-completed-evidence/r9/' + value
+    policy['frontend_resumption_authorization'] = 'frontend-resumption-authorization.json'
+    policy['budgets_and_guards_unchanged'] = True
+    policy_path.write_text(json.dumps(policy, indent=2, ensure_ascii=False) + '\n', encoding='utf-8', newline='\n')
+    print('COMPLETED_R9_EVIDENCE_SNAPSHOT_PASS', len(inventory), 'prior_files', len(prior), flush=True)
+
+
+if __name__ == '__main__':
+    main()
