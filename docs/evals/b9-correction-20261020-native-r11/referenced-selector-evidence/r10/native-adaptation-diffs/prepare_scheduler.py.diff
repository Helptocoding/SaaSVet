+PREFIX = '''def run_all():
+    seal()
+    for label in REQUIRED:
+        if label in ('frontend-test','frontend-smoke-urls','security'):
+            continue
+        assert read_block(label)['state']=='PASS',label
+        save('referenced-block-'+label+'.json',{'state':'REFERENCED_PASS','label':label,
+            'provenance':provenance(label),'application_tests_executed_here':False})
+        print('BLOCK_REFERENCED '+label,flush=True)
+    code=execute('frontend-test-remainder',[PYTHON,'-B',EVIDENCE/'frontend_resumption.py','run'],cwd=TREE/'frontend')
+    if code:stop('PENDING_CLASSIFICATION','frontend-test-remainder','Selected frontend case nonzero; preserve traces',exit_code=code)
+    code=execute('frontend-test-assemble',[PYTHON,'-B',EVIDENCE/'frontend_resumption.py','assemble'],cwd=REPO)
+    if code:stop('PENDING','frontend-test-assemble','Frontend case evidence assembly invalid',exit_code=code)
+    logical=json.loads((BLOCKS/'frontend-tests.json').read_text(encoding='utf-8'))
+    assert logical['logical_aggregate'] is True
+    gate('frontend-test',tests=355,retained_PASS=354,new_PASS=1,
+        command_reference='frontend-test-assemble.command.json',
+        historical_command_exit_1_preserved=True)
+'''
+
+
+def main():
+    target = HERE / 'run_campaign.py'
+    assert not target.exists()
+    source = (PRIOR / 'run_campaign.py').read_text(encoding='utf-8')
+    source = source.replace('from case_resumption import validate_case_references\n    validate_case_references()',
+        'from frontend_resumption import validate_frontend_references\n    validate_frontend_references()')
+    source = replace_function(source, 'seal', SEAL)
+    old_run = next(n for n in ast.parse(source).body if isinstance(n, ast.FunctionDef) and n.name == 'run_all')
+    original_run = ast.get_source_segment(source, old_run)
+    marker = "    for task in ('build','test','lint','smoke:urls'):"
+    assert marker in original_run
+    remaining = original_run[original_run.index(marker):].replace(marker, "    for task in ('lint','smoke:urls'):", 1)
+    source = replace_function(source, 'run_all', PREFIX + remaining)
+    compile(source, str(target), 'exec')
+    assert all(line == line.rstrip() for line in source.splitlines())
+    target.write_text(source, encoding='utf-8', newline='\n')
+    protected = ('execute', 'check_suite', 'budget', 'gate', 'create_db')
+    def methods(path):
+        return {n.name: ast.dump(n, include_attributes=False)
+                for n in ast.parse(path.read_text(encoding='utf-8')).body if isinstance(n, ast.FunctionDef)}
+    before, after = methods(PRIOR / 'run_campaign.py'), methods(target)
+    assert all(before[n] == after[n] for n in protected)
+    print('REMAINING_FIXED_SCHEDULER_PREPARED_NO_TESTS', flush=True)
+
+
+if __name__ == '__main__':
+    main()
