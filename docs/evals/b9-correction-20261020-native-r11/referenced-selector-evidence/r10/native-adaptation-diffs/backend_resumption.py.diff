+HERE=Path(__file__).resolve().parent
+OLD='b271e314817da51e99811cb18921fd7c9f59e58a'
+NEW='f5f18d71847a46d66644775cd90d30268f072e3b'
+CAMPAIGN='b9-correction-20261020-native-r9'
+TARGET='frontend/src/pages/inbox/index.test.jsx'
