+def validate_current_inputs():
+    source=source_root();auth=read(HERE,'frontend-resumption-authorization.json')
+    eq=read(HERE,'frontend-equivalence.json');candidate=read(HERE,'candidate.json')
+    require(candidate['candidate_tree']==NEW and candidate['previous_candidate_tree']==OLD and
+        candidate['only_new_change']==TARGET,'current candidate declaration changed')
+    require(auth['state']=='USER_AUTHORIZED_BEFORE_FORMAL_SEAL' and
+        auth['user_answer']=='Sí, ajustar ese armado y continuar sin repetir PASS' and
+        auth['previous_candidate_tree']==OLD and auth['candidate_tree']==NEW and auth['allowed_path']==TARGET and
+        auth['patch_sha256']==PATCH,'frontend authorization changed')
+    for key in ('no_PASS_reruns','all_new_guards_and_remaining_original_stages_required',
+        'accepted_historical_evidence_limitation','eight_assertions_and_original_5000ms_timeout_unchanged'):
+        require(auth[key] is True,'authorization clause lost '+key)
+    require(auth['product_runtime_locks_changed'] is False and
+        auth['retained_backend_ids']==3331 and auth['retained_frontend_PASS']==354 and
+        auth['new_frontend_selected_ids']==1,'authorized continuation scope changed')
+    require(eq['state']=='PASS' and eq['previous_candidate_tree']==OLD and eq['candidate_tree']==NEW and
+        eq['allowed_path']==TARGET and eq['original_sha256']==OLD_FILE and eq['corrected_sha256']==NEW_FILE and
+        eq['patch_sha256']==PATCH and sha(HERE/'frontend-correction.diff')==PATCH,'frontend equivalence binding changed')
+    for key in ('normalized_complete_module_AST_identical','only_two_input_setup_statements_changed',
+        'eight_assertions_and_original_5000ms_timeout_unchanged','all_other_3331_blobs_identical',
+        'test_ids_imports_hooks_unchanged','retained_backend_and_frontend_build_unaffected',
+        'original_timeout_and_all_historical_FAILs_preserved'):
+        require(eq[key] is True,'frontend equivalence clause lost '+key)
+    require(eq['product_runtime_locks_changed'] is False,'runtime change not authorized')
+    current=read(HERE,'candidate-sources.json');prior=read(source,'candidate-sources.json')
+    require(current['candidate_sha']==NEW and prior['candidate_sha']==OLD,'source manifest tree changed')
+    newer={r['path']:r for r in current['files']};older={r['path']:r for r in prior['files']}
+    require(len(newer)==len(older)==len(current['files'])==len(prior['files'])==3332 and
+        set(newer)==set(older),'candidate source inventory changed')
+    require({p:r for p,r in newer.items() if p!=TARGET}=={p:r for p,r in older.items() if p!=TARGET},
+        'source outside the authorized frontend test changed')
+    require(newer[TARGET]['sha256']==NEW_FILE and older[TARGET]['sha256']==OLD_FILE and
+        newer[TARGET]['git_blob']==eq['corrected_git_blob'] and older[TARGET]['git_blob']==eq['original_git_blob'] and
+        newer[TARGET]['mode']==older[TARGET]['mode']=='100644','frontend source hash/blob/mode changed')
+    assembly=read(HERE,'assembly.json');work=Path(assembly['workspace']).resolve();tree=Path(assembly['tree']).resolve()
+    require(assembly['candidate_sha']==NEW and tree==work/'src' and
+        assembly['platform']=='Windows native' and assembly['wsl_invoked'] is False,'private runtime layout changed')
+    require(all(sha(safe(tree,name))==row['sha256'] for name,row in newer.items()),'current live source drift')
+    corrected=safe(tree,TARGET).read_bytes()
+    require(hashlib.sha256(corrected).hexdigest()==NEW_FILE,'noncanonical current frontend test')
+    original=corrected.decode('utf-8')
+    for composer in ('firstComposer','returnedComposer'):
+        new='        fireEvent.change('+composer+', { target: { value: "Texto idéntico, intención nueva" } });'
+        old='        await user.type('+composer+', "Texto idéntico, intención nueva");'
+        require(original.count(new)==1,'authorized input setup statement not unique')
+        original=original.replace(new,old,1)
+    require(hashlib.sha256(original.encode('utf-8')).hexdigest()==OLD_FILE,
+        'inverse of exactly two authorized input setup calls is not original source')
+    for name in ('dependency-files.json','effective-configuration.json','toolchain.json','recorded_suite.py'):
+        require(sha(HERE/name)==sha(source/name),'prepared backend dependency/configuration drift '+name)
+    for name in ('postgresql.conf','pg_hba.conf'):
+        require(sha(HERE/'private-postgresql'/name)==sha(source/'private-postgresql'/name) and
+            sha(work/'pgdata'/name)==sha(HERE/'private-postgresql'/name),'PostgreSQL configuration drift '+name)
+    return dict(state='PASS',candidate_tree=NEW,source_candidate_tree=OLD,candidate_files=3332,
+        allowed_path=TARGET,unchanged_source_blobs=3331,exact_two_setup_calls_inverse_verified=True,
+        backend_only=False,backend_results_reused=True,frontend_build_result_reused=True,
+        current_backend_test_runs=0,application_tests_executed=False,accepted_historical_evidence_limitation=True)
+
+
+def prepare():
+    require(not (HERE/'evaluation-seal.json').exists() and not (HERE/'invocation-formal.json').exists(),
+        'preparation must precede formal seal')
+    target=HERE/VALIDATION
+    require(not target.exists(),'refusing validation receipt overwrite')
+    result=validate_references();result['inputs']=validate_current_inputs()
+    with target.open('x',encoding='utf-8',newline='\n') as stream:
+        stream.write(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
+    print('RETAINED_BACKEND_AND_BUILD_VALIDATED_NO_TESTS',flush=True)
+
+
+def case_summary():
+    with legacy_context() as (_,case):
+        summary=case.case_summary()
+    return dict(summary,backend_source_campaign=CAMPAIGN,accepted_candidate_tree=NEW,
+        scope='historical backend r9 aggregate; not a new backend test invocation')
+
+
+if __name__=='__main__':
+    require(len(sys.argv)==2 and sys.argv[1]=='prepare','only explicit prepare is supported')
+    prepare()
