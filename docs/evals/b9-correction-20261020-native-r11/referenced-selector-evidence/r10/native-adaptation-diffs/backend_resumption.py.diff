+def require(condition,message):
+    if not condition:raise RuntimeError('Retained r9 evidence: '+message)
+
+
+def sha(path):
+    digest=hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda:stream.read(1024*1024),b''):digest.update(chunk)
+    return digest.hexdigest()
+
+
+def safe(root,name):
+    require(isinstance(name,str) and '\\' not in name and ':' not in name,'invalid artifact path')
+    parts=PurePosixPath(name).parts
+    require(parts and '/'.join(parts)==name and not name.startswith('/') and
+        all(p not in ('','..','.') for p in parts),'artifact path escapes root')
+    path=root
+    for part in parts:
+        path=path/part
+        require(not path.is_symlink() and not path.is_junction(),'linked artifact '+name)
+    require(path.resolve().is_relative_to(root.resolve()),'artifact outside root')
+    return path
+
+
+def read(root,name):
+    return json.loads(safe(root,name).read_text(encoding='utf-8'))
+
+
+def source_root():
+    return safe(HERE,'referenced-completed-evidence/r9')
+
+
+def inventory(root):
+    require(root.is_dir() and not root.is_symlink() and not root.is_junction(),'missing/linked source root')
+    names=set()
+    for path in root.rglob('*'):
+        require(not path.is_symlink() and not path.is_junction(),'linked item in retained source')
+        if path.is_file() and '__pycache__' not in path.relative_to(root).parts:
+            names.add(path.relative_to(root).as_posix())
+    return names
+
+
+def manifest():
+    data=read(HERE,MANIFEST)
+    require(data['schema']=='b9-completed-r9-reference/1' and data['source_campaign']==CAMPAIGN and
+        data['source_candidate_tree']==OLD and data['candidate_tree']==NEW and
+        data['bundle_relative']=='referenced-completed-evidence/r9' and
+        data['original_relative']=='../'+CAMPAIGN,'manifest identity changed')
+    require(isinstance(data['files'],dict) and bool(data['files']),'empty reference manifest')
+    return data
+
+
+def validate_bundle():
+    data=manifest();bundle=source_root();original=HERE.with_name(CAMPAIGN)
+    require(inventory(bundle)==set(data['files']),'retained source inventory differs from manifest')
+    if original.exists():
+        require(inventory(original)==set(data['files']),'original source inventory changed')
+    for name,item in data['files'].items():
+        require(set(item)=={'sha256','bytes'} and isinstance(item['bytes'],int) and item['bytes']>=0 and
+            isinstance(item['sha256'],str) and len(item['sha256'])==64,'invalid manifest item')
+        for root in (bundle,original) if original.exists() else (bundle,):
+            path=safe(root,name)
+            require(path.is_file() and path.stat().st_size==item['bytes'] and sha(path)==item['sha256'],
+                'artifact drift '+str(root/name))
+    return data
+
+
+def _load(name,path):
+    spec=importlib.util.spec_from_file_location(name,path)
+    module=importlib.util.module_from_spec(spec)
+    sys.modules[name]=module
+    try:spec.loader.exec_module(module)
+    except BaseException:
+        sys.modules.pop(name,None)
+        raise
+    return module
+
+
+def legacy_modules():
+    global _MODULES
+    if _MODULES is None:
+        root=source_root()
+        case=_load('_b9_r10_retained_case',root/'case_resumption.py')
+        composite=_load('_b9_r10_retained_composite',root/'composite_evidence.py')
+        _MODULES=(composite,case)
+    return _MODULES
+
+
+@contextmanager
+def legacy_context():
+    composite,case=legacy_modules();absent=object()
+    previous=sys.modules.get('case_resumption',absent)
+    sys.modules['case_resumption']=case
+    try:yield composite,case
+    finally:
+        if previous is absent:sys.modules.pop('case_resumption',None)
+        else:sys.modules['case_resumption']=previous
+
+
+def number(value):
+    return isinstance(value,(int,float)) and not isinstance(value,bool) and math.isfinite(value)
+
+
+def audit_command(label):
+    root=source_root();command=read(root,'blocks/'+label+'.command.json')
+    require(command['state']=='COMPLETED' and command['exit_code']==0 and
+        command['candidate_sha']==OLD and command['formal_run_number']==1 and
+        command.get('invalidating_incident') is None,'source command not valid PASS '+label)
+    monitor=read(root,'monitor-'+label+'.json')
+    require(bool(monitor),'empty source monitor '+label)
+    epochs=[]
+    for row in monitor:
+        host=row['host'];awake=row['awake'];skew=row['wall_minus_monotonic_seconds']
+        require(host['physical_available']>=2*1024**3 and host['disk_available']>=1024**3 and
+            number(skew) and abs(skew)<=1,'source resource/clock incident '+label)
+        require(awake['state']=='ACTIVE_CONFIRMED' and number(awake['sample_age_seconds']) and
+            0<=awake['sample_age_seconds']<=10,'source awake confirmation invalid '+label)
+        epochs.append(host['utc_epoch_seconds'])
+    require(all(0<=b-a<=10 for a,b in zip(epochs,epochs[1:])),'source monitor gap '+label)
+    for phase in ('before','after'):
+        snapshot=command['resources_'+phase]['host']
+        require(snapshot['physical_available']>=2*1024**3 and snapshot['disk_available']>=1024**3,
+            'source command endpoint resource incident '+label)
+        for prefix,field,count in [('integrity','checked_files',3332),
+            ('dependency-check','checked',len(read(root,'dependency-files.json')['files'])),
+            ('seal-check','checked',len(read(root,'evaluation-seal.json')['files']))]:
+            result=read(root,prefix+'-'+phase+'-'+label+'.json')
+            require(result[field]==count and result['mismatches']==[],'source after/before integrity gap '+label)
+    require(command['resources_after']['awake']['state']=='ACTIVE_CONFIRMED','source awake lost after '+label)
+    return dict(state='PASS',command='blocks/'+label+'.command.json',monitor_samples=len(monitor),
+        min_ram_bytes=min(r['host']['physical_available'] for r in monitor),
+        min_disk_bytes=min(r['host']['disk_available'] for r in monitor),
+        max_clock_skew_seconds=max(abs(r['wall_minus_monotonic_seconds']) for r in monitor))
+
+
+def suite(label,count,skips):
+    root=source_root();result=read(root,'blocks/'+label+'.results.json')
+    gate=read(root,'blocks/'+label+'.gate.json');selected=read(root,label+'-selected.json')
+    raw=safe(root,'blocks/'+label+'.ids.jsonl').read_bytes()
+    require(raw.endswith(b'\n'),'truncated source journal '+label)
+    rows=[json.loads(line) for line in raw.splitlines()]
+    ids=[r['id'] for r in rows]
+    require(len(selected)==len(set(selected))==len(ids)==len(set(ids))==count and
+        set(ids)==set(selected)==set(result['test_ids']) and len(result['test_ids'])==count,
+        'source inventory mismatch '+label)
+    require(Counter(r['outcome'] for r in rows)==Counter(PASS=count-skips,**({'SKIP':skips} if skips else {})),
+        'source non-PASS outcomes '+label)
+    require(result['candidate_sha']==OLD and result['tests']==count and result['exit_code']==0 and
+        all(not result[k] for k in ('failures','errors','failed_ids','xfail','xpass')),
+        'source result failure '+label)
+    expected=sorted((r['id'],r.get('reason')) for r in rows if r['outcome']=='SKIP')
+    require(sorted((r['id'],r['reason']) for r in result['skips'])==expected and
+        gate['state']=='PASS' and gate['label']==label and gate['tests']==count and
+        sorted((r['id'],r['reason']) for r in gate['skips'])==expected,'source gate/skip mismatch '+label)
+    return rows,result
+
