+def validate_references():
+    global _CACHE
+    data=validate_bundle();root=source_root()
+    require(read(root,'candidate.json')['candidate_tree']==OLD,'source candidate changed')
+    proof_path=safe(root,'diagnostics/backend-and-frontend-prefix-validation.json')
+    require(sha(proof_path)==PROOF,'completed prefix proof changed')
+    proof=read(root,'diagnostics/backend-and-frontend-prefix-validation.json')
+    require(proof['state']=='PASS_COMPLETE_PREFIX_WITH_FRONTEND_TIMEOUT' and proof['candidate_tree']==OLD and
+        proof['backend']=={'tests':3331,'PASS':3319,'SKIP':12,'gate':'PASS'} and
+        proof['frontend_build']=='PASS' and proof['current_seal_mismatches']==[] and
+        proof['historical_r6_limitation_unchanged'] is True and
+        proof['all_historical_backend_FAILED_attempts_preserved']==3,'completed prefix proof contract changed')
+    require(all(data['files'][name]['sha256']==wanted for name,wanted in proof['files'].items()),
+        'completed prefix proof artifact binding changed')
+    with legacy_context() as (legacy,case):
+        reused=legacy.validate_references()
+        historical={campaign:legacy._audit_source(legacy._bundle(campaign),campaign) for campaign in legacy.SEAL_HASHES}
+        case_info=case.validate_case_references()
+        expected={}
+        for _,rows in case.active()['sources'].values():
+            for row in rows:
+                if row['outcome'] in ('PASS','SKIP'):
+                    require(row['id'] not in expected,'historical accepted cases overlap')
+                    expected[row['id']]=row
+        tail=read(root,'blocks/full-general-remainder.results.json')
+        tail_rows=[json.loads(line) for line in safe(root,'blocks/full-general-remainder.ids.jsonl').read_bytes().splitlines()]
+        require(len(tail_rows)==1 and tail_rows[0]['id']==case.FAILED[0] and tail_rows[0]['outcome']=='PASS' and
+            tail['candidate_sha']==OLD and tail['tests']==1 and tail['test_ids']==case.FAILED and tail['exit_code']==0 and
+            all(not tail[k] for k in ('failures','errors','failed_ids','skips','xfail','xpass')) and
+            read(root,'blocks/full-general-remainder.gate.json')['state']=='PASS','corrected backend case not PASS')
+        expected[tail_rows[0]['id']]=tail_rows[0]
+        general,_=suite('full-general',3213,12)
+        require(set(expected)=={r['id'] for r in general},'general accepted case union changed')
+        for row in general:
+            original={k:v for k,v in row.items() if k not in ('case_provenance','evidence_source')}
+            require(original==expected[row['id']],'general row differs from source observation')
+        critical=set().union(*(set(read(root,label+'-selected.json')) for label in ('directed','b0','b3','b4','b5')))
+        require(not critical & {r['id'] for r in general if r['outcome']=='SKIP'},'critical backend case skipped')
+        all_rows,full_result=suite('full',3331,12)
+        partition=read(root,'full-partition.json')
+        require(partition['state']=='PASS' and partition['candidate_tree']==OLD and partition['total_ids']==3331 and
+            partition['duplicate_ids']==0 and not partition['missing_ids'],'full partition changed')
+        expected_labels={'full-b8b':21,'full-b8c':41,'full-b8d':27,'full-b8e':29,'full-general':3213}
+        require({r['label']:r['count'] for r in partition['groups']}==expected_labels,'full group counts changed')
+        expected_full={r['id']:r for r in general}
+        for label,count in expected_labels.items():
+            if label=='full-general':continue
+            selected=read(root,label+'-selected.json')
+            source_rows=[json.loads(line) for line in legacy.block_path(label,'.ids.jsonl').read_bytes().splitlines()]
+            require(len(selected)==len(source_rows)==count and {r['id'] for r in source_rows}==set(selected),
+                'full family selection changed '+label)
+            for row in source_rows:
+                require(row['id'] not in expected_full,'full group overlap')
+                expected_full[row['id']]=row
+        require(len(expected_full)==3331 and set(expected_full)=={r['id'] for r in all_rows},
+            'full journal not exact general+118 union')
+        for row in all_rows:
+            require({k:v for k,v in row.items() if k not in ('case_provenance','evidence_source')}==
+                {k:v for k,v in expected_full[row['id']].items() if k not in ('case_provenance','evidence_source')},
+                'full observation changed')
+    commands={name:audit_command(name) for name in ('full-general-remainder','full-general-assemble','frontend-build')}
+    require(read(root,'blocks/frontend-build.gate.json')['state']=='PASS','frontend build gate not PASS')
+    command=read(root,'blocks/frontend-build.command.json')
+    require(command['argv'][-2:]==['run','build'],'frontend build command changed')
+    require(full_result.get('continuous_campaign_claimed') is False and full_result.get('accepted_historical_evidence_limitation') is True,
+        'historical limitation lost')
+    _CACHE=dict(state='PASS',candidate_tree=NEW,source_candidate_tree=OLD,source_campaign=CAMPAIGN,
+        backend_tests=3331,backend_PASS=3319,backend_SKIP=12,frontend_build='REFERENCED_PASS',
+        historical_reference_blocks=13,manifest=MANIFEST,manifest_sha256=sha(HERE/MANIFEST),
+        completed_prefix_proof_sha256=PROOF,reference_files=len(data['files']),source_commands=commands,
+        accepted_historical_evidence_limitation=True,continuous_campaign_claimed=False,
+        application_tests_executed=False,current_backend_tests_executed=0,
+        case_summary=case_info)
+    return dict(_CACHE)
