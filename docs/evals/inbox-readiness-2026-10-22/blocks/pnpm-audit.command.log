      "references": "- https://github.com/axios/axios/security/advisories/GHSA-x97p-jq2g-jp4f\n- https://nvd.nist.gov/vuln/detail/CVE-2026-101909\n- https://github.com/axios/axios/pull/11141\n- https://github.com/axios/axios/commit/d19040bda7a8be2f82c3c6e1a5bc03917daee39a\n- https://github.com/axios/axios/commit/d29be181f85f6fe93397a07b1f69606d9622637b\n- https://github.com/axios/axios/releases/tag/v0.34.0\n- https://github.com/axios/axios/releases/tag/v1.20.0\n- https://github.com/advisories/GHSA-x97p-jq2g-jp4f",
