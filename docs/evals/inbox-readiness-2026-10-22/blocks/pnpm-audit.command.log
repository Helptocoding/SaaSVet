      "references": "- https://github.com/axios/axios/security/advisories/GHSA-mghh-pgcx-3jjj\n- https://nvd.nist.gov/vuln/detail/CVE-2026-101906\n- https://github.com/axios/axios/pull/11141\n- https://github.com/axios/axios/commit/d19040bda7a8be2f82c3c6e1a5bc03917daee39a\n- https://github.com/axios/axios/releases/tag/v1.20.0\n- https://github.com/advisories/GHSA-mghh-pgcx-3jjj",
      "created": "2026-09-30T15:03:02.000Z",
