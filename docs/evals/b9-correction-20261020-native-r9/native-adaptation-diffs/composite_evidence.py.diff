+def _baseline_transform(corrected):
+    """Invert the reviewed tuple/comment and prove the complete original module."""
+    _require(hashlib.sha256(corrected).hexdigest() == NEW_BASELINE_SHA,
+             'corrected baseline bytes are not the authorized proposal')
+    addition = (
+        '    # Revisado en B9: B3 introdujo los dos checks de TurnWork en\n'
+        '    # services._capture_witness y services._apply_release. Ambos filtran por\n'
+        '    # conversation=convo bajo lock; la vista resuelve ese padre con\n'
+        '    # Conversation.objects.for_organization(request.user.organization).\n'
+        '    # Es scoping por FK padre tenant-validado, no una lectura cross-org.\n'
+        "    ('agent', 'services.py', 'TurnWork', 'filter'),\n"
+    )
+    text = corrected.decode('utf-8')
+    _require(text.count('BASELINE = {\n' + addition) == 1,
+             'baseline contains an unapproved tuple/comment change')
+    original = text.replace('BASELINE = {\n' + addition, 'BASELINE = {\n', 1)
+    raw = original.encode('utf-8')
+    _require(hashlib.sha256(raw).hexdigest() == OLD_BASELINE_SHA,
+             'baseline inverse differs from the entire original source')
+    old_ast, new_ast = ast.parse(original), ast.parse(text)
+
+    def baseline(module):
+        nodes = [node for node in module.body if isinstance(node, ast.Assign) and
+                 any(isinstance(target, ast.Name) and target.id == 'BASELINE' for target in node.targets)]
+        _require(len(nodes) == 1 and isinstance(nodes[0].value, ast.Set),
+                 'baseline assignment changed')
+        return nodes[0].value
+
+    old_set, new_set = baseline(old_ast), baseline(new_ast)
+    old_values = [ast.literal_eval(node) for node in old_set.elts]
+    new_values = [ast.literal_eval(node) for node in new_set.elts]
+    entry = ('agent', 'services.py', 'TurnWork', 'filter')
+    _require(len(old_values) == 23 and len(new_values) == 24 and entry not in old_values and
+             new_values.count(entry) == 1 and set(new_values) - set(old_values) == {entry} and
+             not set(old_values) - set(new_values), 'baseline tuple scope changed')
+    new_set.elts = [node for node in new_set.elts if ast.literal_eval(node) != entry]
+    _require(ast.dump(old_ast, include_attributes=False) == ast.dump(new_ast, include_attributes=False),
+             'baseline scanner, assertions, exclusions, imports, hooks or test IDs changed')
+    git_blob = lambda data: hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()
+    return {'original_sha256': OLD_BASELINE_SHA, 'corrected_sha256': NEW_BASELINE_SHA,
+            'original_git_blob': git_blob(raw), 'corrected_git_blob': git_blob(corrected),
+            'original_bytes': len(raw), 'corrected_bytes': len(corrected)}
+
+
+def _baseline_equivalence(tree):
