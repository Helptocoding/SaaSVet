# ---------------------------------------------------------------------------
# .env.prod.example — copy to .env.prod and fill EVERY value.
#
# Capa 2 (DEPLOY_VPS_PLAN.md). On the VPS:
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   chown deploy:deploy .env.prod
# .env.prod is git-ignored. NEVER commit it.
# ---------------------------------------------------------------------------

# ===========================================================================
# Django core
# ===========================================================================

DEBUG=False
# Generate fresh:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_RUN_THE_COMMAND_ABOVE
ENVIRONMENT=production

# CRITICAL: include `localhost` and `127.0.0.1` alongside the real domain.
# The Docker healthcheck calls http://localhost:8000/api/healthz/ from
# inside the container — without `localhost` here Django returns 400.
ALLOWED_HOSTS=app.tu-dominio.com,localhost,127.0.0.1

CSRF_TRUSTED_ORIGINS=https://app.tu-dominio.com
CORS_ALLOWED_ORIGINS=https://app.tu-dominio.com

# Used by Caddy (Capa 3) for vhost matching and by frontend Dockerfile arg.
DOMAIN=app.tu-dominio.com

# Capa 3: contact email for Let's Encrypt. Used for renewal failure alerts
# + recovery. Use a real inbox you check — LE only emails when something
# breaks. If left blank, Caddy still works but you lose the early warning.
ACME_EMAIL=admin@tu-dominio.com

# ===========================================================================
# Security headers (production hardening)
# ===========================================================================

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Flip to True only when you intend to submit the domain to hstspreload.org.
# Once preloaded, browsers refuse HTTP even if you ever roll back.
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Slug secreto del panel Django admin (ofuscación de superficie — A9 / HIGH H4).
# El backend monta admin.site.urls bajo este slug y Caddy enruta /{slug}* al
# backend; ambos leen ESTA misma variable, así que nunca se desincronizan.
#   - `/admin` literal SIEMPRE responde 404 en producción (Caddy lo bloquea).
#   - Solo ADMIN_SAAS (is_staff=True) puede autenticarse; los roles de clínica
#     (ADMIN/VET/ASSISTANT, is_staff=False) son rechazados en el login.
# REGLAS:
#   - NO debe empezar con 'admin' (colisiona con el bloqueo 404 de Caddy).
#   - Si se deja SIN setear: fail-closed — el admin queda inaccesible.
# Generar uno fuerte:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DJANGO_ADMIN_URL=CHANGE_ME_RANDOM_SLUG_NOT_STARTING_WITH_admin

# ===========================================================================
# Public IDs
# ===========================================================================

# Capa 8 / ADR p18: false in production so PKs are never resolvable from URLs.
ALLOW_LEGACY_ID_LOOKUP=False

# ===========================================================================
# Database (postgres service on the internal compose network)
# ===========================================================================

# DATABASE_URL is what Django reads (via dj_database_url). The PG* vars below
# are read by the postgres container ITSELF on first boot to initialize the
# cluster. Keep all four credentials matching.
DATABASE_URL=postgresql://vet:CHANGE_ME_STRONG_PG_PASSWORD@postgres:5432/veterinaria
PGUSER=vet
PGPASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
PGDATABASE=veterinaria
PGHOST=postgres
PGPORT=5432

# postgres:16-alpine init vars (only consumed on the very first container
# start, when /var/lib/postgresql/data is empty). Changing these later does
# NOT change the actual DB user/password — you'd need to ALTER USER manually.
POSTGRES_USER=vet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
POSTGRES_DB=veterinaria

# ===========================================================================
# Sentry (both DSNs are PUBLIC — designed to ship in client + server bundles)
# ===========================================================================

SENTRY_DSN=
# Baked into the React bundle at build time. If empty, Sentry init is a no-op.
VITE_SENTRY_DSN=

# Capa 7: trace sampling. 0.05 = 5% (default sane prod value). Sube a 1.0
# en dev para ver el 100% de spans. Cada trace cuenta contra cuota Sentry,
# así que en prod >0.1 escala rápido con tráfico.
SENTRY_TRACES_SAMPLE_RATE=0.05

# Capa 7: release tag opcional. Si lo seteás, Sentry agrupa issues por
# release y detecta regresiones. Patrón típico: SHA git corto del deploy.
# Setear en el wrapper de deploy (CI o script local) con:
#   SENTRY_RELEASE=$(git rev-parse --short HEAD)
# Vacío en este file = sin tag (Sentry agrupa todo bajo "unknown release").
SENTRY_RELEASE=

# P1-5 A5: versión desplegada que expone /api/version/ y que Sentry usa como
# release del backend (fallback si SENTRY_RELEASE está vacío).
# P1-6B: NO editar a mano — `scripts/deploy.sh` hace upsert de GIT_SHA +
# SENTRY_RELEASE con `git rev-parse --short HEAD` en cada deploy. Dejar vacío
# en el primer arranque manual (entonces /api/version/ reporta "dev").
GIT_SHA=
# Etiqueta legible opcional (default = GIT_SHA o "dev").
APP_VERSION=

# P1-6B: tag de imagen Docker a construir/correr. NO setear aquí — lo exporta
# `scripts/deploy.sh` (=GIT_SHA) y `scripts/rollback.sh` (=tag previo) por
# invocación. El compose cae a `latest` si no está definido (primer boot manual).
# IMAGE_TAG=

# P1-5 A4: upload de source maps del frontend a Sentry (build-time, CI).
# SECRETOS — pasar al `docker compose build` del frontend. Vacíos = sin upload
# (el plugin no se carga). El auth token NUNCA llega al bundle ni al image runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================================================
# Soporte — webhook de Discord (botón "Reportar problema", apps/core/services)
# ===========================================================================

# Webhook al que el backend reenvía los reportes de soporte. Es un SECRETO:
# quien lo tenga puede postear en tu canal de Discord.
# FORMATO (deploy.sh hace `source .env.prod`, así que la línea se parsea como
# bash): UNA sola línea, SIN espacios alrededor del '=', SIN salto de línea en
# la URL. Una línea mal formada (o un espacio tras el '=') hace que bash intente
# ejecutar la URL como comando → "No such file or directory" y aborta el deploy.
# Si se deja vacío, el endpoint /api/support/message/ responde 503 (soporte
# deshabilitado) — NO rompe el arranque.
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_URL=

# ===========================================================================
# Frontend build-time vars (consumed by vite during `pnpm run build`)
# ===========================================================================

# Must match the public domain + /api/ — the bundle is immutable after build.
VITE_API_URL=https://app.tu-dominio.com/api/

# ===========================================================================
# Gunicorn tuning
# ===========================================================================

# Rule of thumb: workers = 2 * vCPU + 1. For a 2-vCPU VPS, 3 is sensible.
# Each worker uses ~150-250MB RSS depending on Django warm-up.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ===========================================================================
# Redis — cache backend + DRF login-throttle store (P1-1, ADR p41)
# ===========================================================================

# Shared cache across gunicorn workers. Holds ONLY: the 30s dashboard summary
# cache and login/brute-force throttle counters. NOTHING authoritative — no
# JWT, no sessions, no idempotency keys, no financial/clinical data.
# Format: redis://:PASSWORD@redis:6379/1  (db 1; PASSWORD must match REDIS_PASSWORD)
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/1

# requirepass for the redis container (defense in depth on the internal net,
# even though the port is never published). MUST equal the password embedded
# in REDIS_URL above.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Break-glass ONLY. Default False. If Redis is hard-down in production and you
# must boot without it, set True to fall back to per-worker LocMemCache. This
# RE-WEAKENS the multi-worker login throttle (brute-force protection diluted
# ×N_workers). Treat as a MAX 24h emergency: restore Redis and set back to
# False ASAP (ADR p41). With REDIS_URL set, this flag is ignored.
ALLOW_LOCAL_CACHE_EMERGENCY=False

# ===========================================================================
# Backup & Disaster Recovery (ADR p40) — read by scripts/pg-backup.sh
# ===========================================================================

# Offsite target for the nightly encrypted dump. Format: `remote:bucket[/path]`
# where `remote` is the name configured in rclone.conf. With ENVIRONMENT=production
# this MUST be set or pg-backup.sh fails loud (no offsite = no backup).
# Example (Backblaze B2 bucket saaslyvet-prod-backups):
#   RCLONE_REMOTE=saaslyvet-prod-backups:saaslyvet-prod-backups
RCLONE_REMOTE=

# age PUBLIC key (recipient) used to encrypt the dump before it leaves the host.
# This is NOT a secret — it can only encrypt. The matching PRIVATE key lives
# OFFLINE (operator machine + offline backup), NEVER on the VPS. Without the
# private key nobody — including a VPS attacker — can read the backups.
#   BACKUP_ENCRYPTION_PUBLIC_KEY=age1wkpxyd7m9e664wmscuq39d7wk20z5g3ht7xzhnh80pa548j379nsnpq6a8
BACKUP_ENCRYPTION_PUBLIC_KEY=

# Healthchecks.io deadman ping. pg-backup.sh pings it ONLY on full success;
# if the backup fails (or never runs), the missing ping fires the alert.
#   HEALTHCHECK_URL=https://hc-ping.com/<uuid>
HEALTHCHECK_URL=

# ===========================================================================
# Agente WhatsApp (É-F0) — webhook + sender + worker
# Runbook completo: docs/runbooks/agent-whatsapp.md
# ===========================================================================

# Token de verificación del handshake del webhook (lo eliges tú; pégalo igual
# en la config del webhook en Meta for Developers). Vacío = handshake rechaza.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta (Meta for Developers → App settings → Basic).
# Firma HMAC de cada POST del webhook. SECRETO. Vacío = el webhook rechaza
# TODO POST (fail-closed) — el subsistema queda sordo pero seguro.
WHATSAPP_APP_SECRET=

# Access token para ENVIAR mensajes (System User token permanente en prod;
# el token temporal de 24h del sandbox sirve para pruebas). SECRETO.
WHATSAPP_ACCESS_TOKEN=

# Base de la Graph API. Solo cambiar para bump de versión sin release.
# WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# Deadman del worker del agente (Healthchecks.io, mismo patrón que el backup).
# El loop pinguea cada ~60 ciclos sanos; sin ping en schedule+grace → alerta.
#   HEALTHCHECK_AGENT_WORKER_URL=https://hc-ping.com/<uuid>
HEALTHCHECK_AGENT_WORKER_URL=

# ---------------------------------------------------------------------------
# Modelo de lenguaje (É-F1). SIN ESTO EL AGENTE ESCALA TODO A HUMANO: el
# cliente levanta "LLM no configurado" en la primera llamada y el turno
# degrada a handoff. Los tier-0 (urgencia, saludo, horario) sí siguen
# funcionando, así que el fallo NO es evidente a simple vista.
# ---------------------------------------------------------------------------

# Proveedor: cualquiera compatible con la API de OpenAI (/chat/completions con
# tool calling). Es configuración, no código — cambiar de proveedor es cambiar
# estas tres variables. Ej.: https://api.deepseek.com
AGENT_LLM_BASE_URL=
# SECRETO.
AGENT_LLM_API_KEY=
# Modelo del planner (el que conversa y decide herramientas). Ej.: deepseek-chat
AGENT_LLM_MODEL_PLANNER=
# Modelo barato opcional para clasificación; si va vacío se usa el del planner.
AGENT_LLM_MODEL_ROUTER=

# Contabilidad de costo (USD por millón de tokens del proveedor elegido).
# Solo alimenta LLMCall.cost_estimate y el reporte de agent_quality; 0 = sin
# pricing configurado. No afecta el comportamiento.
AGENT_LLM_COST_PER_MTOK_INPUT=0
AGENT_LLM_COST_PER_MTOK_OUTPUT=0

# Loopback del worker hacia la API propia (nombre del servicio en el compose).
# AGENT_INTERNAL_API_URL=http://backend:8000

# Presupuestos y umbrales (defaults sanos; solo tocar con datos del piloto).
# AGENT_MAX_LLM_TURNS_PER_CONVERSATION=40   # red de contención, no disparador
# AGENT_MAX_TOOLS_PER_TURN=5
# AGENT_SLOT_CONFIDENCE_THRESHOLD=0.70      # bajo esto, el dato se confirma

# ===========================================================================
# NOT included on purpose
# ===========================================================================
# - DJANGO_SUPERUSER_USERNAME / DJANGO_SUPERUSER_PASSWORD
#     Bootstrap the platform admin manually via `createsuperuser` one time.
#     Leaving creds in env makes them readable from /proc/<pid>/environ and
#     defeats the password rotation audit trail.
# - The rclone B2 Application Key. It lives ONLY in rclone.conf (chmod 600,
#     ~/.config/rclone/rclone.conf), never in .env.prod. The VPS key must have
#     write+list+read but NO deleteFiles / bypassGovernance (ADR p40), so a
#     compromised host cannot erase the immutable offsite history.
# - BACKUP_DECRYPTION_KEY (age PRIVATE key). Used only by pg-restore.sh /
#     restore-drill.sh on the OPERATOR machine during a real restore. NEVER
#     stored on the VPS.
# - Any value containing real secrets at commit time. .env.prod is local-only.
