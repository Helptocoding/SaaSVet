# Capa 6 (DEPLOY_VPS_PLAN.md): crontab template para el VPS.
#
# Install:
#   crontab scripts/crontab.example
#
# Edit paths primero si tu install difiere de /home/deploy/apps/SaaSVet.
# Validar sintaxis antes de instalar:
#   crontab -T scripts/crontab.example   (algunos sistemas)
#   o:  cat scripts/crontab.example | crontab -l ; echo $?
#
# Verificar tras install:
#   crontab -l                            # debe imprimir estas líneas
#   sudo grep CRON /var/log/syslog        # ver disparos (Ubuntu)
#
# IMPORTANTE: corre como user `deploy` (NO como root). crontab -e como
# user `deploy` después de SSH al VPS:
#   ssh deploy@<vps>
#   crontab scripts/crontab.example
#
# OJO TIMEZONE: el host saaslyvet-prod-01 corre en America/Monterrey (UTC-6) y
# cron interpreta TODAS las expresiones de abajo en hora LOCAL de Monterrey, no
# UTC. Conversión: hora local + 6h = UTC. Por eso el backup va en `0 21 * * *`
# (21:00 Monterrey = 03:00 UTC), la ventana de baja actividad documentada. Cada
# job lleva su equivalente UTC en el comentario. Ver docs/runbooks/cron-jobs.md
# y docs/production-runbook.md §G.

# ---------------------------------------------------------------------------
# Vars compartidas para todos los jobs.
# ---------------------------------------------------------------------------
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COMPOSE_DIR=/home/deploy/apps/SaaSVet
ENV_FILE=/home/deploy/apps/SaaSVet/.env.prod
COMPOSE_FILE=/home/deploy/apps/SaaSVet/docker-compose.prod.yml
BACKUP_DIR=/var/backups/vet
# Offsite + cifrado (ADR p40). En producción RCLONE_REMOTE es OBLIGATORIO
# (pg-backup.sh falla loud si está vacío). Estos pueden vivir aquí o en
# .env.prod (.env.prod gana si los define en ambos lados).
#   RCLONE_REMOTE=b2:saaslyvet-prod-backups
#   BACKUP_ENCRYPTION_PUBLIC_KEY=age1...          # PUBLIC key (no es secreto)
# Deadman switch (Healthchecks.io) — ping solo en éxito total:
#   HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# La App Key de B2 NO va aquí: vive en ~/.config/rclone/rclone.conf (chmod 600).
# La PRIVATE key de age NUNCA va al VPS (solo en restore real desde tu máquina).

# m h dom mon dow command

# ---------------------------------------------------------------------------
# 21:00 Monterrey local = 03:00 UTC diario — pg_dump → validate (pg_restore
# --list) → sha256 + manifest → age encrypt → rclone copy a B2 (daily/, y
# monthly/ el día 01) + retención local 14d + deadman ping (ADR p40).
# Exit: 0 OK | 1 precond | 2 dump corrupto | 3 pg_dump falló |
#       4 validación falló | 5 cifrado/rclone no disponible | 6 offsite falló (prod).
# Si exit != 0 el deadman NO se pinguea → Healthchecks.io alerta. Define MAILTO
# arriba para recibir stderr también.
# ---------------------------------------------------------------------------
0 21 * * *  /home/deploy/apps/SaaSVet/scripts/pg-backup.sh >> /var/log/vet-backup.log 2>&1

# ---------------------------------------------------------------------------
# 04:00 Monterrey local = 10:00 UTC diario — JWT cleanup (ADR p20). Sin esto
# las tablas token_blacklist_outstandingtoken + token_blacklist_blacklistedtoken
# crecen lineales con cada login / refresh / change-password.
# ---------------------------------------------------------------------------
0 4 * * *   cd $COMPOSE_DIR && docker compose -f $COMPOSE_FILE --env-file $ENV_FILE run --rm backend python manage.py flushexpiredtokens >> /var/log/vet-cron.log 2>&1

# ---------------------------------------------------------------------------
# 06:30 Monterrey local = 12:30 UTC diario — Analytics snapshot ayer (ADR p10).
# Idempotente + per-org advisory lock. Failures per-org aislados, exit 2
# si CUALQUIER org falla — wire alerta en exit != 0.
# Corre tras el cierre del día calendario MX anterior (ya pasó medianoche local).
# ---------------------------------------------------------------------------
30 6 * * *  cd $COMPOSE_DIR && docker compose -f $COMPOSE_FILE --env-file $ENV_FILE run --rm backend python manage.py build_daily_metrics >> /var/log/vet-cron.log 2>&1

# ---------------------------------------------------------------------------
# 06:35 Monterrey local = 12:35 UTC diario — Anchor integrity audit (corre
# DESPUÉS del snapshot). Exit 0 OK | 1 unresolved provenance | 2 invariant
# violation (P1, page on this).
# ---------------------------------------------------------------------------
35 6 * * *  cd $COMPOSE_DIR && docker compose -f $COMPOSE_FILE --env-file $ENV_FILE run --rm backend python manage.py audit_anchor_integrity --json >> /var/log/vet-anchor.log 2>&1

# ---------------------------------------------------------------------------
# Cada hora (minuto 15) — disk usage alert. Si /, /var/lib/docker o
# /var/backups/vet exceden 80%, POST a webhook. Exporta ALERT_WEBHOOK
# arriba o inline. Sin webhook configurado solo loguea (no alerta).
# ---------------------------------------------------------------------------
15 * * * *  ALERT_THRESHOLD=80 /home/deploy/apps/SaaSVet/scripts/disk-alert.sh >> /var/log/vet-cron.log 2>&1

# ---------------------------------------------------------------------------
# RESTORE DRILL — NO automatizar por cron (decisión beta, 2026-06-20).
#
# El restore real debe probar la cadena de desastre COMPLETA:
#   B2 download → age decrypt → restore → auditorías.
# Eso requiere la age PRIVATE key, que NUNCA vive en el VPS. El drill local
# (sin --from-offsite) NO prueba B2 ni el descifrado: usa el .dump plano local,
# crea una DB temporal en el postgres de prod y levanta un container backend.
# Poco valor + partes móviles en prod para una beta.
#
# En su lugar: drill MANUAL mensual desde la máquina del operador, con la
# age private key montada temporalmente:
#   BACKUP_DECRYPTION_KEY=/ruta/segura/age.key \
#   RCLONE_REMOTE=b2:saaslyvet-prod-backups \
#     scripts/restore-drill.sh --from-offsite      # → RESTORE VERIFIED
# Si pasan >35 días sin un RESTORE VERIFIED offsite, es deuda P0.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Semanal — logs systemd journal cap a 14 días (evita crecimiento sin tope).
# 05:00 Monterrey local (domingos) = 11:00 UTC.
# ---------------------------------------------------------------------------
0 5 * * 0   sudo journalctl --vacuum-time=14d >> /var/log/vet-cron.log 2>&1
