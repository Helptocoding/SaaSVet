# Capa 3 (DEPLOY_VPS_PLAN.md): public-facing reverse proxy.
#
# Caddy responsibilities:
#   - Terminate TLS (ACME auto-issuance via Let's Encrypt for real domains;
#     internal self-signed CA when DOMAIN=localhost for smoke).
#   - Route requests:
#       /api/*            → backend:8000 (gunicorn)
#       /hooks/*          → backend:8000 (webhooks públicos, firma HMAC — É-F0)
#       /static/*         → static_files volume (Django admin + DRF assets)
#       /admin/*          → backend:8000 (with optional IP allow-list)
#       /                 → frontend:80 (nginx serving the SPA bundle)
#   - Inject security headers (HSTS, X-Frame-Options, Referrer-Policy,
#     Permissions-Policy, CSP) on every response.
#   - Compress responses (gzip + zstd).
#   - Emit access logs as JSON to stdout (Docker captures).
#
# DO NOT add other proxies inside the bundle (no nginx layer 2). Caddy is
# the single entrypoint. The frontend image's nginx serves only the SPA on
# the internal network — Caddy proxies to it directly.

{
	# ACME contact. Replace with a real email for cert expiry alerts.
	email {$ACME_EMAIL}

	# Access log goes to stdout in JSON; admin endpoint disabled (security).
	admin off
}

# Temporary beta deployment — the landing is intentionally served from a SEPARATE
# repository (SaaSVet-Landing) via the RO bind-mount in docker-compose.prod.yml.
# This will be decoupled in a future infrastructure migration. See docs/deuda C8.
# Independent Caddy site (apex + www); does not touch {$DOMAIN} (app) or admin.
saaslyvet.com, www.saaslyvet.com {
	encode zstd gzip

	root * /srv/landing
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
	}
}

{$DOMAIN} {

	# -----------------------------------------------------------------------
	# Compression — applied to text/*, json, javascript, etc. by default.
	# -----------------------------------------------------------------------
	encode zstd gzip

	# -----------------------------------------------------------------------
	# Security headers — applied to every response, BEFORE handlers run.
	# Browser only enforces HSTS on TLS responses; safe to send always.
	# -----------------------------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		# Cross-origin isolation defaults. Sentry replay/Stripe SDKs may
		# need to relax COEP — revisit when integrating.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# CSP — strict baseline. Adjust only with concrete justification.
		#   - 'self' covers SPA bundle + API on same origin.
		#   - Google Fonts kept (already used by index.html).
		#   - Sentry connect-src whitelist covers ingest endpoint.
		#   - data: img-src allows inline favicons / generated avatars.
		#   - 'unsafe-inline' on style-src is required by Google Fonts'
		#     injected <style> blocks; mitigated by absence of script
		#     'unsafe-inline'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.ingest.us.sentry.io https://*.ingest.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Hide upstream identity.
		-Server
		-X-Powered-By
	}

	# -----------------------------------------------------------------------
	# Healthcheck (no auth, no logs) — UptimeRobot / healthchecks.io target.
	# Keep this BEFORE the catch-all so it short-circuits.
	# -----------------------------------------------------------------------
	@health path /api/healthz /api/healthz/ /api/readyz /api/readyz/
	handle @health {
		reverse_proxy backend:8000
	}

	# -----------------------------------------------------------------------
	# Django admin — Capa 8 / HIGH H4.
	# Uncomment + populate `admin_allowed_ips` to lock /admin/* to your
	# office/VPN IPs. With it commented, /admin/* is reachable from any IP
	# (Django session auth still required — but visibility = attack surface).
	# -----------------------------------------------------------------------
	# @admin_allowed_ips {
	# 	remote_ip 203.0.113.42/32 198.51.100.0/24
	# }
	# @admin path /admin/* /admin
	# handle @admin {
	# 	@blocked not remote_ip 203.0.113.42/32 198.51.100.0/24
	# 	handle @blocked {
	# 		respond "Not Found" 404
	# 	}
	# 	reverse_proxy backend:8000
	# }

	# -----------------------------------------------------------------------
	# Static Django assets (admin CSS, DRF browsable API) — served directly
	# from the shared static_files volume. Avoids backend round-trip.
	# -----------------------------------------------------------------------
	handle_path /static/* {
		root * /srv/static
		file_server {
			precompressed gzip
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# -----------------------------------------------------------------------
	# API — gunicorn. Forward original client IP / proto / host so Django's
	# logging + ALLOWED_HOSTS + SECURE_PROXY_SSL_HEADER (if enabled) work.
	# -----------------------------------------------------------------------
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For   {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host  {host}
			header_up X-Real-IP         {remote_host}

			# Caddy default transport timeouts are sane; tighten only if
			# you observe slow upstreams. transport http { read_timeout 60s }
		}
	}

	# -----------------------------------------------------------------------
	# Webhooks entrantes (É-F0) — WhatsApp Cloud API. FUERA de /api/: endpoint
	# público que autentica por firma HMAC del proveedor (no JWT). DEBE
	# enrutar al backend igual que /api/*; sin este bloque cae al catch-all
	# (SPA) y el handshake de verificación de Meta recibe HTML → falla.
	# -----------------------------------------------------------------------
	handle /hooks/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For   {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host  {host}
			header_up X-Real-IP         {remote_host}
		}
	}

	# -----------------------------------------------------------------------
	# Django admin — superficie ofuscada (HIGH H4 / A9).
	#
	# El admin real vive bajo un slug secreto leído de la MISMA env var que usa
	# Django (`backend/config/urls.py`): el operador setea DJANGO_ADMIN_URL en
	# .env.prod y compose lo inyecta al servicio caddy. Si ambos leen el mismo
	# valor, el routing y la ruta de Django nunca se desincronizan.
	#
	# Fail-closed: si DJANGO_ADMIN_URL NO está seteada, el placeholder cae al
	# default `__admin_disabled__` → el admin queda INACCESIBLE (no se expone en
	# ninguna ruta adivinable) hasta que se configure el slug. No hay default a
	# 'admin' aquí a propósito: colisionaría con el bloque 404 de abajo y
	# reabriría la superficie.
	#
	# REGLA: el slug de producción NO debe empezar con 'admin' — el handler de
	# 404 literal de abajo captura `/admin*` y lo bloquearía.
	handle /{$DJANGO_ADMIN_URL:__admin_disabled__}* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For   {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host  {host}
		}
	}

	# `/admin` literal SIEMPRE 404 en producción — no revela que existe un panel
	# ni dónde. Debe ir junto al handler del slug; Caddy ordena los `handle` por
	# especificidad de path, así que un slug distinto de 'admin' no colisiona.
	handle /admin* {
		respond "Not Found" 404
	}

	# -----------------------------------------------------------------------
	# Catch-all → SPA bundle served by the frontend nginx container.
	# The frontend image already handles SPA fallback (try_files → index.html).
	# -----------------------------------------------------------------------
	handle {
		reverse_proxy frontend:80
	}

	# -----------------------------------------------------------------------
	# Logging — JSON to stdout (Docker captures). Healthz noise can be
	# filtered downstream (`docker logs caddy | grep -v healthz`) or via a
	# log matcher when you wire shipping.
	# -----------------------------------------------------------------------
	log {
		output stdout
		format json
		level INFO
	}
}

# ---------------------------------------------------------------------------
# Internal liveness listener — the Docker healthcheck target.
#
# The healthcheck runs INSIDE this container (loopback). It must NOT probe the
# public `{$DOMAIN}` block: that block forces HTTP→HTTPS and its TLS cert is
# issued for the domain, not `localhost`. So `http://localhost/` hits the
# 308 redirect and `https://localhost/` fails cert validation — and busybox
# `wget` in alpine has no reliable TLS. Either way the container is flagged
# `unhealthy` even though the public stack is fine.
#
# This dedicated `http://` site address disables auto-HTTPS for itself: no
# redirect, no TLS, no ACME (so no Let's Encrypt rate-limit risk). It answers
# a pure 200 (liveness) — decoupled from backend so a backend hiccup can't
# cascade caddy to `unhealthy`. External uptime monitors still use the domain
# `@health` route above, which traverses to backend.
#
# Port 8081 is NOT in the compose `ports:` block → unreachable from the
# internet; only the in-container healthcheck (loopback) hits it. Everything
# other than the health path 404s, so this listener exposes nothing else.
# ---------------------------------------------------------------------------
http://localhost:8081 {
	@health path /api/healthz /api/healthz/
	handle @health {
		respond 200
	}
	handle {
		respond 404
	}
}
